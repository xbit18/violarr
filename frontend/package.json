    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "type-fest": "2.19.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.7"
